{
  "name": "scouts-system-monorepo",
  "version": "1.0.0",
  "description": "Scout Organization Management Platform - Monorepo",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=frontend",
    "verify": "npm run verify --workspace=backend",
    "verify:mssql": "npm run verify:mssql --workspace=backend",
    "verify:postgres": "npm run verify:postgres --workspace=backend",
    "test:system": "npx tsx --env-file=frontend/.env.local backend/scripts/system-test-suite.ts",
    "migrate:cloud": "npx tsx backend/scripts/migrate-cloud.ts",
    "worker": "npm run worker --workspace=backend"
  },
  "type": "module"
}
