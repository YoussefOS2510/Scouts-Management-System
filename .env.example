# ==============================================================================
# Scout Organization Management Platform - Environment Configuration Template
# Copy this file to .env or .env.local and populate the values as needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_NAME="Scout Management Platform"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. Database Connection (Microsoft SQL Server 2025 - ScoutsDB)
# ------------------------------------------------------------------------------
# Option A: Full Connection String (Default for ODBC Driver 18 with Windows Integrated Security)
MSSQL_CONNECTION_STRING="Driver={ODBC Driver 18 for SQL Server};Server=(local);Database=ScoutsDB;Trusted_Connection=yes;TrustServerCertificate=yes;"

# Option B: Explicit Credentials (If using SQL Server Authentication instead of Windows Auth)
MSSQL_SERVER="localhost"
MSSQL_PORT=1433
MSSQL_DATABASE="ScoutsDB"
MSSQL_USER="sa"
MSSQL_PASSWORD="YourStrongPassword123!"
MSSQL_ENCRYPT="true"
MSSQL_TRUST_SERVER_CERT="true"

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
# Secret key used to sign JWT session tokens (generate a strong random string in production)
AUTH_SECRET="change-this-to-a-secure-random-32-byte-hex-secret"
JWT_EXPIRATION="7d"

# ------------------------------------------------------------------------------
# 4. Media Ingestion & 15 GB Local Staging Buffer
# ------------------------------------------------------------------------------
# Local scratch folder path where raw photos/videos are buffered before uploading to Google Drive
MEDIA_STAGING_DIR="./staging_buffer"
MEDIA_MAX_FILE_SIZE_MB=500
MEDIA_MAX_CONCURRENT_UPLOADS=2

# ------------------------------------------------------------------------------
# 5. Google Drive API v3 (Asynchronous Archival Pipeline)
# ------------------------------------------------------------------------------
# Absolute or relative path to the Google Cloud Service Account JSON key file
GOOGLE_APPLICATION_CREDENTIALS="./secrets/google-service-account.json"

# Master Google Drive Folder ID where /ScoutsArchive/{Year}/{UnitName}/{EventName}/ will be created
GOOGLE_DRIVE_ROOT_FOLDER_ID="your_google_drive_folder_id_here"

# ------------------------------------------------------------------------------
# 6. Optional Containerized Database (PostgreSQL via Docker Compose)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=scouts_db
POSTGRES_PORT=5432
